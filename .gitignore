# ==============================================================================
# AI Career Recommendation Stack — Root .gitignore
# ==============================================================================

# Node dependencies & caches
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python environments & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Environment variables & secrets (NEVER COMMIT SENSITIVE KEYS)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# Database volumes & local persistence
career_mysql_data/
*.sqlite
*.sqlite3
*.db
pids
*.pid
*.seed
*.pid.lock

# Build & bundle artifacts
client/dist/
dist/
out/
.cache/
.parcel-cache/

# Debug and diagnostic outputs
debug_output.txt
*.log

# IDE & Editor settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
ehthumbs.db
